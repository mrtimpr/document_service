# Основные параметры Django.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Подключение к PostgreSQL.
POSTGRES_DB=document_service
POSTGRES_USER=document_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://document_user:change-me@db:5432/document_service

# Брокер и хранилище результатов Celery.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# SMTP-параметры электронной почты.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@example.com
ADMIN_EMAIL=admin@example.com

# Ограничение размера одного документа.
MAX_DOCUMENT_SIZE_MB=20
